# Copy this file to .env and fill in your own keys:  cp .env.example .env
# .env is git-ignored: never commit real keys.

# --- API keys (required) ---
# Gemini: embeddings (vector search + ingestion)
GEMINI_API_KEY=your-gemini-api-key-here
# Groq: answer generation + LLM-as-a-judge
GROQ_API_KEY=your-groq-api-key-here

# --- Models (optional) ---
# Groq retires models regularly. If /ask returns 503 saying the model is not
# available, check https://console.groq.com/docs/deprecations and change it here.
GROQ_GENERATION_MODEL=openai/gpt-oss-120b
# Defaults to GROQ_GENERATION_MODEL when empty.
GROQ_JUDGE_MODEL=

# --- Generation and retrieval (optional) ---
GENERATION_TEMPERATURE=0.1
GENERATION_MAX_TOKENS=4096
RETRIEVAL_TOP_K=5

# --- Postgres (required for Docker Compose) ---
POSTGRES_USER=app_user
POSTGRES_PASSWORD=choose-a-password
POSTGRES_DB=cattle_assistant
